{
    "manifest_version": 3,
    "name": "OnlyChat",
    "version": "0.1.0",
    "description": "Use Instagram for Direct Messages only: no feed, Reels or Explore. Stories only from the people you chat with.",
    "permissions": ["storage"],
    "action": {
        "default_title": "OnlyChat",
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
            "js": ["content.js"],
            "css": ["content.css", "theme.css", "fonts/geist.css"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
            "js": ["stories.js", "notes.js", "profile.js"],
            "world": "MAIN",
            "run_at": "document_idle"
        }
    ]
}
